{
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": [
		"prettier-plugin-svelte",
		"@ianvs/prettier-plugin-sort-imports",
		"prettier-plugin-css-order"
	],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	],
	"importOrder": [
		"<BUILTIN_MODULES>",
		"",
		"^react",
		"<THIRD_PARTY_MODULES>",
		"",
		"^[.]",
		"",
		"<TYPES>",
		"<TYPES>^[.]"
	],
	"importOrderParserPlugins": ["typescript", "jsx", "importAttributes"],
	"importOrderTypeScriptVersion": "5.0.0"
}
