{
	"name": "svelte-template",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#snkrs-sdk": "./nike-release-checker/snkrs-sdk/index.ts",
		"#snkrs-sdk/mocks/handlers": "./nike-release-checker/snkrs-sdk/mocks/handlers/handlers.ts"
	},
	"scripts": {
		"dev": "vite",
		"dev:mobile": "cross-env MOBILE_MODE=true vite --host",
		"build": "vite build",
		"preview": "vite preview",
		"lint:ts": "tsc --noEmit --allowImportingTsExtensions --project tsconfig.app.json",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"knip": "knip"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "4.7.0",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@tsconfig/svelte": "^5.0.6",
		"@types/node": "24.10.1",
		"@vitejs/plugin-basic-ssl": "2.1.0",
		"cross-env": "10.1.0",
		"knip": "5.71.0",
		"msw": "2.12.4",
		"prettier": "3.7.4",
		"prettier-plugin-css-order": "2.1.2",
		"prettier-plugin-svelte": "3.4.0",
		"svelte": "5.45.5",
		"svelte-check": "4.3.4",
		"typescript": "5.9.3",
		"vite": "7.2.6",
		"vite-plugin-qrcode": "0.3.0",
		"vite-tsconfig-paths": "5.1.4"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
