{
	"name": "nike-ui-release-checker",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"dev:mobile": "cross-env MOBILE_MODE=true vite --host",
		"build": "vite build",
		"preview": "vite preview",
		"lint:ts": "tsc --project tsconfig.app.json",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"knip": "knip",
		"skills:check": "npx skills check"
	},
	"dependencies": {
		"@nike-release-checker/sdk": "https://github.com/whoisYeshua/nike-release-checker/releases/download/%40nike-release-checker%2Fsdk%400.3.1/nike-release-checker-sdk-0.3.1.tgz"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "24.10.1",
		"@vitejs/plugin-basic-ssl": "2.1.4",
		"@vercel/node": "5.6.9",
		"cross-env": "10.1.0",
		"knip": "5.85.0",
		"msw": "2.12.10",
		"prettier": "3.8.1",
		"prettier-plugin-css-order": "2.2.0",
		"prettier-plugin-svelte": "3.5.0",
		"svelte": "5.53.6",
		"svelte-check": "4.4.4",
		"typescript": "5.9.3",
		"vite": "7.3.1",
		"vite-plugin-qrcode": "0.3.0",
		"vite-tsconfig-paths": "6.1.1"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
