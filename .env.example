# Sentry DSN — get from Sentry project settings → Client Keys
# SDK is silently disabled when this is empty
VITE_SENTRY_DSN=

# Sentry source map upload (only needed for production builds)
# Create at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
